{
  "name": "steam-wishlist-family-owned",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Marca en la wishlist de Steam los juegos que ya tiene alguien de tu Familia de Steam",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:login": "node e2e/login.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "zip": "wxt zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sethyrus/steam-wishlist-family-owned.git"
  },
  "homepage": "https://github.com/Sethyrus/steam-wishlist-family-owned#readme",
  "bugs": {
    "url": "https://github.com/Sethyrus/steam-wishlist-family-owned/issues"
  },
  "keywords": [
    "steam",
    "wishlist",
    "family-sharing",
    "browser-extension",
    "chrome-extension",
    "wxt"
  ]
}
